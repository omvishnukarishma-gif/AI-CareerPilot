# ===== AI CareerPilot — Backend Environment Variables =====
# Copy this file to .env and fill in real values.
#   cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
#
# NEVER commit the .env file. It is listed in .gitignore.

# --- Application ---
APP_NAME="AI CareerPilot"
# Set DEBUG=false in production (default is false)
DEBUG=false
API_V1_PREFIX="/api/v1"

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# In production, replace with your actual frontend URL(s).
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- Database ---
# Option A (Docker): use these defaults that match docker-compose.yml
# Option B (Local):  point to your local PostgreSQL instance
DATABASE_URL="postgresql+psycopg://careerpilot:careerpilot_dev@localhost:5432/careerpilot_dev"

# --- AI / LLM ---
# The API key is loaded here and NEVER exposed to the frontend.
# When empty (default), all features use deterministic heuristics.
# To enable AI-powered recommendations and feedback, set this to your
# OpenAI-compatible API key (OpenAI, OpenRouter, LM Studio, Ollama, etc.).
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL="https://api.openai.com/v1"

# --- Security / JWT ---
# In production, generate a strong random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="dev-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- File uploads ---
# Directory where uploaded resumes are stored (relative to backend/).
# In production, point this to a persistent volume or object-storage mount.
UPLOAD_DIR="uploads"
# Maximum allowed upload size in megabytes.
MAX_UPLOAD_SIZE_MB=5
