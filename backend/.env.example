# ===== AI CareerPilot — Backend Environment Variables =====
# Copy this file to .env and fill in real values.
#   cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
#
# NEVER commit the .env file. It is listed in .gitignore.

# --- Application ---
APP_NAME="AI CareerPilot"
# Set DEBUG=false in production (default is false)
DEBUG=false
API_V1_PREFIX="/api/v1"

# --- Frontend serving ---
# Set to true in production (Docker / Render) to have FastAPI serve the
# compiled React SPA.  Leave false for local development so the Vite dev
# server handles the frontend and `/` returns JSON.
SERVE_FRONTEND=false

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# In production, replace with your actual frontend URL(s).
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- Database ---
# Option A (Docker): use these defaults that match docker-compose.yml
# Option B (Local):  point to your local PostgreSQL instance
DATABASE_URL="postgresql+psycopg://careerpilot:careerpilot_dev@localhost:5432/careerpilot_dev"

# --- AI / LLM ---
# The API key is loaded here and NEVER exposed to the frontend.
# When empty (default), all features use deterministic heuristics.
# To enable AI-powered recommendations and feedback, set this to your
# OpenAI-compatible API key (OpenAI, OpenRouter, LM Studio, Ollama, etc.).
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL="https://api.openai.com/v1"

# --- Security / JWT ---
# In production, generate a strong random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="dev-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- File uploads ---
# Directory where uploaded resumes are stored.
# Relative paths are resolved relative to the backend/ directory.
#
# Production / Render:
#   Uploaded files are stored in the container filesystem and are LOST on
#   every new deployment unless you attach a persistent disk.
#   - Free/Hobby tier: files are ephemeral. Resume TEXT is stored in
#     PostgreSQL (content_text column) and survives restarts, but the
#     original file cannot be re-downloaded after a restart.
#   - Paid plans: attach a Render Persistent Disk, mount it at
#     /app/backend/uploads (or any path), and set:
#       UPLOAD_DIR=/app/backend/uploads
#   Note: the TEXT content used for AI features persists in the database
#   regardless of whether the physical file survives.
UPLOAD_DIR="uploads"
# Maximum allowed upload size in megabytes.
MAX_UPLOAD_SIZE_MB=5
