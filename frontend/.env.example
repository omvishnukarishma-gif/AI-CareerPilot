# ===== AI CareerPilot — Frontend Environment Variables =====
# Copy this file to .env and fill in real values.
#   Copy-Item .env.example .env   (PowerShell)

# The VITE_ prefix is required by Vite to expose the variable to the browser.
# Only non-sensitive values go here — never put API keys or secrets here.
#
# Development (default): leave VITE_API_URL empty or omit it entirely.
# The Vite dev server proxies /api/* to the backend (see vite.config.ts),
# so the frontend talks to /api/v1 on the same origin and CORS is not needed.
#
# Production / Docker: set this to the public backend URL, e.g.:
#   VITE_API_URL=https://api.myapp.com/api/v1
#
VITE_API_URL=
